# Campaign Studio — local Docker environment.
#
# Every variable below maps to a field on app/config/settings.py::Settings
# (pydantic-settings reads env vars case-insensitively against the field
# name, e.g. `database_url` <- DATABASE_URL). Loaded two ways by
# docker-compose-local.yml, both from this same file: as `env_file: .env`
# for the api/worker containers' runtime environment, and, because this
# file sits next to docker-compose-local.yml, automatically for the
# ${VARIABLE} interpolation used inside that compose file (POSTGRES_USER
# etc.) — Docker Compose auto-loads a `.env` from the project directory
# for both purposes.
#
# DATABASE_URL and TEMPORAL_HOST below use `localhost`. That's what you get
# if you run `uvicorn`/`python -m app.worker` directly on the host, outside
# any container. Inside docker-compose-local.yml, `api` and `worker`
# explicitly override both to the in-network service hostnames (`postgres`,
# `temporal:7233`) — see that file's `environment:` blocks — so the values
# here never actually reach the containers. They're kept accurate anyway so
# this file works unmodified for local-without-Docker too.

# --- Core ---------------------------------------------------------------
ENVIRONMENT=local
PROVIDER_MODE=fixture
# fixture = every provider port (LLM, search, page reading, image, video,
# storage) runs against canned adapters, no external calls, no credentials
# needed. This is what makes `make local` work with a completely empty set
# of API keys below. Flip to "real" only once every *_API_KEY below is
# filled in — see the note under the provider keys about a bug that
# currently makes "real" mode crash regardless.

# --- Database -------------------------------------------------------------
# Must stay in sync with POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# below if you change any of them - nothing derives this one from the
# others automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campaign_studio

# Used by the `postgres` service in docker-compose-local.yml, not read by
# the app directly (Settings has no POSTGRES_USER field - the app only
# ever sees the assembled DATABASE_URL above).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campaign_studio
POSTGRES_HOST_PORT=5432

# --- Temporal ---------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=campaign-studio

# --- Provider credentials (all optional while PROVIDER_MODE=fixture) --------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
TAVILY_API_KEY=

# --- Storage ------------------------------------------------------------------
STORAGE_BACKEND=local
# Container-side path; docker-compose-local.yml's bind mount (..:/code)
# means this also lands at <project-root>/data/assets on your host, so
# generated assets are inspectable without shelling into the container.
LOCAL_STORAGE_PATH=/code/data/assets
# Only read when STORAGE_BACKEND=s3 - left blank under the local default.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

# --- Research agent bounds ------------------------------------------------------
RESEARCH_MAX_TOOL_CALLS=20
RESEARCH_MAX_ITERATIONS=6
RESEARCH_TIMEOUT_SECONDS=300

# --- Reference image upload limits -----------------------------------------------
MAX_REFERENCE_IMAGE_MB=10
# JSON array - pydantic-settings parses list[str] env vars as JSON.
ALLOWED_REFERENCE_IMAGE_TYPES=["image/jpeg","image/png"]

# --- Output dimensions (defaults match Settings; override only if you need to) ---
IMAGE_SQUARE_WIDTH_PX=1080
IMAGE_SQUARE_HEIGHT_PX=1080
IMAGE_VERTICAL_WIDTH_PX=1080
IMAGE_VERTICAL_HEIGHT_PX=1920
VIDEO_WIDTH_PX=1080
VIDEO_HEIGHT_PX=1920
VIDEO_MIN_DURATION_SECONDS=6
VIDEO_MAX_DURATION_SECONDS=10